  nonmonotone = minimize(bb(), f, c(-1.2, 1), gr = g)@counts[["f"]])

# Constants outside their intervals are rejected, and the error names
# the argument.
try(armijo(c1 = 1))
try(armijo(shrink = 1.5))
try(armijo(max_step = 2.5))

